---
type LanguageOption = { code: string; label?: string };
interface Props {
  name?: string;
  languages?: LanguageOption[];
  currentLanguage?: string;
  defaultLanguage?: string;
}
const { name, languages = [], currentLanguage, defaultLanguage }: Props = Astro.props as Props;
const baseUrl = import.meta.env.BASE_URL;
const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const basePath = normalizedBaseUrl.endsWith('/') ? normalizedBaseUrl.slice(0, -1) : normalizedBaseUrl;
const currentPath = Astro.url.pathname;
const pathWithoutBase = currentPath.startsWith(basePath) ? currentPath.slice(basePath.length) : currentPath;
const currentLanguagePrefix = currentLanguage && defaultLanguage && currentLanguage !== defaultLanguage ? `/${currentLanguage}` : '';
const defaultLanguagePrefix = defaultLanguage ? `/${defaultLanguage}` : '';
let pathWithoutLanguage = pathWithoutBase;
if (currentLanguagePrefix && pathWithoutLanguage.startsWith(currentLanguagePrefix)) {
  pathWithoutLanguage = pathWithoutLanguage.slice(currentLanguagePrefix.length);
}
if (defaultLanguagePrefix && pathWithoutLanguage.startsWith(`${defaultLanguagePrefix}/`)) {
  pathWithoutLanguage = pathWithoutLanguage.slice(defaultLanguagePrefix.length);
}
if (defaultLanguagePrefix && pathWithoutLanguage === defaultLanguagePrefix) {
  pathWithoutLanguage = '';
}
const pathSuffix = pathWithoutLanguage === '' ? '/' : pathWithoutLanguage;
const homeHref = `${basePath}${currentLanguagePrefix}/`;
const blogHref = import.meta.env.PUBLIC_BLOG_URL ?? 'https://blog.lsarmiento.dev';
const showLanguageSelector = languages.length > 0 && currentLanguage && defaultLanguage;
---

<header class="fixed left-0 right-0 top-0 z-50">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 py-3">
      <div class="flex items-center text-left">
        {name && <span class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-300">{name}</span>}
      </div>
      <nav class="inline-flex items-center justify-center gap-2 rounded-full bg-slate-950/70 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-200 ring-1 ring-inset ring-slate-800 backdrop-blur">
        <a class="transition hover:text-white" href={homeHref}>Home</a>
        <span class="text-slate-500">/</span>
        <a class="transition hover:text-white" href={blogHref} target="_blank" rel="noreferrer">Blog</a>
      </nav>
      <div class="flex justify-end text-right">
        {showLanguageSelector && (
          <div class="inline-flex gap-1 rounded-full bg-slate-950/70 p-1 ring-1 ring-inset ring-slate-800 backdrop-blur">
            {languages.map((language) => (
              <a
                class={`rounded-full px-3 py-1 text-xs font-semibold transition ${language.code === currentLanguage
                  ? 'bg-indigo-500/20 text-indigo-100 ring-1 ring-inset ring-indigo-500/60'
                  : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}
                href={`${basePath}${defaultLanguage && language.code === defaultLanguage ? '' : `/${language.code}`}${pathSuffix}`}
              >
                {language.code}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</header>
