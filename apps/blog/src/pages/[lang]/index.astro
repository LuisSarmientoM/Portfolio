---
import resume from '../../data/resume.json';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

type TranslationKey = keyof typeof resume.translations;

const languages = resume.languages;
const translationKeys = Object.keys(resume.translations) as TranslationKey[];
const defaultLanguage = (languages[0]?.code as TranslationKey) ?? translationKeys[0];

export function getStaticPaths() {
  return resume.languages.map(({ code }) => ({
    params: { lang: code },
  }));
}

const requestedLangParam = Astro.params.lang;
const requestedLang = translationKeys.find((code) => code === requestedLangParam) as TranslationKey | undefined;

if (!requestedLang || requestedLang === defaultLanguage) {
  return Astro.redirect(import.meta.env.BASE_URL);
}

const getEntryLang = (id: string): TranslationKey | undefined => {
  const cleanId = id.replace(/\.md$/, '');
  const parts = cleanId.split('/');
  return parts.find((part) => translationKeys.includes(part as TranslationKey)) as TranslationKey | undefined;
};

const posts = (await getCollection('blog')).filter(({ id }: { id: string }) => getEntryLang(id) === requestedLang);
const getSlug = (id: string) => id.split('/').pop()?.replace(/\.md$/, '') ?? id;
const sorted = posts.sort(
  (a: (typeof posts)[number], b: (typeof posts)[number]) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const headerName = 'Luis Sarmiento';
const pageTitle = requestedLang === 'en' ? 'Luis Sarmiento Blog | Web architecture and development' : 'Blog de Luis Sarmiento | Arquitectura y desarrollo web';
const pageDescription =
  requestedLang === 'en'
    ? 'Notes about frontend and backend architecture, web performance, NestJS, Angular and real-world development workflows.'
    : 'Notas sobre arquitectura frontend y backend, rendimiento web, NestJS, Angular y procesos reales de desarrollo.';
const canonicalHref = new URL(`/${requestedLang}/`, Astro.site).toString();
const xDefaultHref = new URL('/', Astro.site).toString();
const alternateLinks = languages.map(({ code }) => ({
  hreflang: code,
  href: new URL(code === defaultLanguage ? '/' : `/${code}/`, Astro.site).toString(),
}));
const ogImage = new URL('/og/blog-home.svg', Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Luis Sarmiento Blog',
  description: pageDescription,
  url: canonicalHref,
  inLanguage: requestedLang,
  blogPost: sorted.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    url: new URL(`/${requestedLang}/${getSlug(post.id)}/`, Astro.site).toString(),
  })),
};
const formatDate = (value: Date) =>
  new Intl.DateTimeFormat(requestedLang === 'en' ? 'en-US' : 'es-CO', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  }).format(value);
---

<BaseLayout
  name={headerName}
  lang={requestedLang}
  title={pageTitle}
  description={pageDescription}
  canonicalHref={canonicalHref}
  alternateLinks={alternateLinks}
  xDefaultHref={xDefaultHref}
  ogImage={ogImage}
  jsonLd={jsonLd}
  languages={languages}
  currentLanguage={requestedLang}
  defaultLanguage={defaultLanguage}
>
  <section class="card relative overflow-hidden p-8">
    <div class="absolute left-0 top-0 h-1 w-28 rounded-full ribbon" />
    <p class="text-xs uppercase tracking-[0.28em] text-muted">Blog</p>
    <h1 class="mt-2 text-3xl font-bold leading-tight text-primary sm:text-4xl">Processes behind the portfolio</h1>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-secondary/90">
      Brief notes on how I design, document and optimize interfaces. Each entry is a snapshot of my way of working and
      the questions that appear in my day to day.
    </p>
  </section>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1.6fr_1fr]">
    <div class="space-y-4">
      {sorted.map((post: (typeof sorted)[number]) => (
        <a
          class="block rounded-2xl bg-surface/60 p-6 ring-1 ring-inset ring-stroke transition hover:-translate-y-1 hover:bg-surface-strong/80 hover:ring-accent/30"
          href={`/${requestedLang}/${getSlug(post.id)}/`}
        >
          <div class="flex flex-wrap items-center justify-between gap-3 text-sm text-muted">
            <span>{formatDate(post.data.date)}</span>
            {post.data.tags && (
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag: string) => (
                  <span class="rounded-full bg-surface-strong/80 px-3 py-1 text-xs font-semibold text-secondary ring-1 ring-inset ring-stroke">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
          <h2 class="mt-3 text-2xl font-semibold text-primary">{post.data.title}</h2>
          <p class="mt-2 text-base leading-relaxed text-secondary/90">{post.data.description}</p>
        </a>
      ))}
    </div>

    <aside class="card flex flex-col gap-6 p-6">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-muted">Quick archive</p>
        <p class="mt-2 text-sm text-secondary">
          All entries live in Markdown to keep the workflow light and versioned. You can read them on the site or from the repository.
        </p>
      </div>
      <div class="rounded-2xl bg-surface/50 p-5 ring-1 ring-inset ring-stroke">
        <p class="text-sm font-semibold text-primary">Contact</p>
        <p class="mt-2 text-sm text-secondary/90">Want to propose a topic or collaborate on a post?</p>
        <a
          class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-accent transition hover:-translate-y-0.5 hover:text-muted"
          href="mailto:hello@lsarmiento.dev"
        >
          Write to me at hello@lsarmiento.dev
        </a>
      </div>
    </aside>
  </div>
</BaseLayout>
