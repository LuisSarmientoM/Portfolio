---
import ShellLayout from "./ShellLayout.astro";
import "../styles/blog.css";

interface Props {
    title?: string;
    description?: string;
    date?: string;
    tags?: string[];
    canonicalHref?: string;
    alternateLinks?: Array<{ hreflang: string; href: string }>;
    xDefaultHref?: string;
    ogImage?: string;
    jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
    lang?: string;
    languages?: Array<{ code: string; label?: string }>;
    currentLanguage?: string;
    defaultLanguage?: string;
    name?: string;
}

const {
    title,
    description,
    date,
    tags,
    canonicalHref,
    alternateLinks,
    xDefaultHref,
    ogImage,
    jsonLd,
    lang,
    languages,
    currentLanguage,
    defaultLanguage,
    name,
} = Astro.props as Props;
const normalizedBaseUrl = "/";
const blogIndexHref =
    currentLanguage && defaultLanguage && currentLanguage !== defaultLanguage
        ? `${normalizedBaseUrl}${currentLanguage}/`
        : normalizedBaseUrl;
---

<ShellLayout
    lang={lang}
    title={title ? `${title} | Blog` : "Luis Sarmiento Blog"}
    description={description}
    canonicalHref={canonicalHref}
    alternateLinks={alternateLinks}
    xDefaultHref={xDefaultHref}
    ogType="article"
    ogImage={ogImage}
    jsonLd={jsonLd}
    languages={languages}
    currentLanguage={currentLanguage}
    defaultLanguage={defaultLanguage}
    name={name}
>
    <main class="mx-auto max-w-7xl px-6 pb-10 pt-24 sm:pb-14 sm:pt-28 lg:pb-16">

        <article class="blog-content max-w-prose mx-auto">
            <a
                class="inline-flex items-center gap-2 text-sm font-semibold text-accent transition hover:-translate-y-0.5 hover:text-muted"
                href={blogIndexHref}
            >
                ← Volver al blog
            </a>
            <slot />
        </article>
    </main>
</ShellLayout>
