---
import ShellLayout from "./ShellLayout.astro";
import "../styles/blog.css";

interface Props {
    title?: string;
    description?: string;
    date?: string;
    tags?: string[];
    lang?: string;
    languages?: Array<{ code: string; label?: string }>;
    currentLanguage?: string;
    defaultLanguage?: string;
    name?: string;
}

const {
    title,
    description,
    date,
    tags,
    lang,
    languages,
    currentLanguage,
    defaultLanguage,
    name,
} = Astro.props as Props;
const baseUrl = import.meta.env.BASE_URL;
const normalizedBaseUrl = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const blogIndexHref =
    currentLanguage && defaultLanguage && currentLanguage !== defaultLanguage
        ? `${normalizedBaseUrl}${currentLanguage}/`
        : normalizedBaseUrl;
---

<ShellLayout
    lang={lang}
    languages={languages}
    currentLanguage={currentLanguage}
    defaultLanguage={defaultLanguage}
    name={name}
>
    <Fragment slot="head">
        <title>{title} · Blog</title>
        {description && <meta name="description" content={description} />}
    </Fragment>
    <main class="mx-auto max-w-7xl px-6 pb-10 pt-24 sm:pb-14 sm:pt-28 lg:pb-16">

        <article class="blog-content max-w-prose mx-auto">
            <a
                class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-300 transition hover:-translate-y-0.5 hover:text-emerald-200"
                href={blogIndexHref}
            >
                ← Volver al blog
            </a>
            <slot />
        </article>
    </main>
</ShellLayout>
